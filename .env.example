# V.I.K.e V1 — environment configuration
# Copy to .env and fill in. NEVER commit .env.

PORT=3000

# LLM provider: "mock" (default, zero keys, zero cost) or "openai"
# (any OpenAI-compatible API). The app runs end-to-end on "mock".
LLM_PROVIDER=mock

# --- Real provider settings (only needed when LLM_PROVIDER=openai) ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Stripe (founding memberships). Test mode first! ---
# The SECRET key goes here on YOUR machine / hosting dashboard env vars.
# It is NEVER in the browser and NEVER in git. The publishable key is
# not needed: checkout runs on Stripe's hosted page via the server.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_FOUNDING_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Public URL of the deployed app (for Stripe's redirect back).
# APP_URL=https://vike.example.com
